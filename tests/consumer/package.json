{
  "name": "ds-consumer-check",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Project outside the pnpm workspace that installs the packed tarballs. Run it with `pnpm verify:package` from the repository root.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\" \"test/*.test.cjs\" && tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
